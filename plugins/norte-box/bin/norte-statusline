#!/usr/bin/env bash
# norte-statusline - a barrinha do Norte-box (statusLine do Claude Code).
#
# Formato EXATO aprovado pelo CEO:
#
#     ▲12  ·  ctx:11%  ·  Opus
#
#   - "▲12"      = a marca Norte (▲) COLADA no numero da conversa (#N). SEM "·" no meio.
#   - "ctx:11%"  = quanto do contexto ja foi usado, com 3 faixas de cor:
#                     <60%  neutro | 60-80% amarelo | >80% vermelho.
#   - "Opus"     = a IA (model.display_name, ja vem abreviado: Opus/Sonnet/Haiku).
#   - SEM assunto, SEM NRT. So o numero, que e a ancora fixa da conversa.
#
# COMO O #N FUNCIONA (a maquina do usuario NAO tem o registro NRT do CEO):
#   O Norte-box mantem um contador LOCAL proprio. Chave = session_id (o Claude Code garante
#   que ele e "estavel pela vida da sessao e unico por sessao"). Guardamos um mapa
#   session_id -> N em ~/.norte-box/conversas.map (1 linha por conversa). A 1a vez que vemos
#   um session_id, ele ganha o proximo N (max+1) e a linha e gravada; na RETOMADA (mesmo
#   session_id) reusa o mesmo N. Assim o numero e estavel e facil de achar, e NUNCA e o NRT.
#
# LEIS (as mesmas dos outros hooks do Norte-box):
#   - FAIL-OPEN TOTAL: a barra e cosmetica. Falta de ~/.norte-box, jq, campo, permissao,
#     race -> a barra DEGRADA (ex: "▲ · ctx:--% · Opus"), NUNCA quebra a sessao. exit 0 sempre.
#   - Consome stdin como DADO, JAMAIS executa. Zero eval/source de conteudo externo.
#   - Script "burro e rapido": so jq + stdin + 1 arquivo local. ZERO rede, ZERO git,
#     ZERO chamada a registry/cockpit. Nao carrega nada do lado do CEO.
#   - Portabilidade macOS: bash 3.2. Sem EPOCHREALTIME, sem mapfile, sem recursos novos.
set -u

STATE_DIR="${HOME}/.norte-box"
MAP="${STATE_DIR}/conversas.map"
LOCK="${STATE_DIR}/conversas.map.lock"   # lock por mkdir (atomico e portatil)

# --- 1) Consome stdin SEMPRE (evita SIGPIPE). E dado, jamais comando. ---
_stdin="$(cat 2>/dev/null || true)"

# --- 2) Sem jq nao ha parse seguro de JSON -> degrada, nao quebra. ---
if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' "▲ · ctx:--% · —"
  exit 0
fi

# --- 3) Campos nativos (todos com fallback // empty; nunca confiamos que existam). ---
_model="$(printf '%s' "$_stdin"   | jq -r '.model.display_name // empty' 2>/dev/null || true)"
_sid="$(printf '%s' "$_stdin"     | jq -r '.session_id // empty'          2>/dev/null || true)"
# used_percentage pode vir int (11) ou float (10.4); pegamos o inteiro pra exibir "11%".
_pct_raw="$(printf '%s' "$_stdin" | jq -r '.context_window.used_percentage // empty' 2>/dev/null || true)"

[ -n "$_model" ] || _model="—"

# Percentual: valida que e numero; senao "--".
_pct=""
case "$_pct_raw" in
  ''|*[!0-9.]*) _pct="" ;;                       # vazio ou tem char nao-numerico -> invalido
  *) _pct="$(printf '%.0f' "$_pct_raw" 2>/dev/null || printf '%s' "${_pct_raw%%.*}")" ;;
esac
# clamp defensivo 0..100 (nao confiamos cegamente na entrada)
if [ -n "$_pct" ]; then
  [ "$_pct" -lt 0 ]   2>/dev/null && _pct=0
  [ "$_pct" -gt 100 ] 2>/dev/null && _pct=100
fi

# --- 4) Resolve o #N da conversa a partir do session_id (contador local proprio). ---
#     Idempotente: mesma sessao -> mesmo N. Novo session_id -> proximo N.
#     Tudo fail-open: qualquer tropeco deixa N vazio (barra vira "▲").
_n=""
_resolve_n() {
  [ -n "$_sid" ] || return 0
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0

  # 4a) Ja existe esse session_id no mapa? (leitura sem lock; barato e comum)
  if [ -f "$MAP" ]; then
    _n="$(awk -F '\t' -v s="$_sid" '$1==s {print $2; exit}' "$MAP" 2>/dev/null || true)"
    [ -n "$_n" ] && return 0
  fi

  # 4b) Nao existe -> precisa atribuir o proximo N. Lock curto por mkdir (atomico).
  #     Se nao conseguir o lock em ~1s, degrada (sem N) em vez de travar a barra.
  _got_lock=""
  _i=0
  while [ "$_i" -lt 10 ]; do
    if mkdir "$LOCK" 2>/dev/null; then _got_lock=1; break; fi
    _i=$((_i + 1))
    sleep 0.1 2>/dev/null || true
  done
  [ -n "$_got_lock" ] || return 0
  # trava garantida liberada em qualquer saida desta funcao
  # (retornos abaixo passam por aqui via 'trap'-menos: liberamos explicitamente)

  # Re-checa dentro do lock (outra sessao pode ter gravado enquanto esperavamos).
  if [ -f "$MAP" ]; then
    _n="$(awk -F '\t' -v s="$_sid" '$1==s {print $2; exit}' "$MAP" 2>/dev/null || true)"
    if [ -n "$_n" ]; then rmdir "$LOCK" 2>/dev/null || true; return 0; fi
  fi

  # Calcula max(N)+1 do mapa (0 se vazio/inexistente).
  _max="$(awk -F '\t' 'BEGIN{m=0} $2 ~ /^[0-9]+$/ && $2+0>m {m=$2+0} END{print m}' "$MAP" 2>/dev/null || printf '0')"
  case "$_max" in ''|*[!0-9]*) _max=0 ;; esac
  _n=$((_max + 1))

  # Grava a linha nova (append atomico). Se a gravacao falhar, zera N (degrada).
  if ! printf '%s\t%s\n' "$_sid" "$_n" >> "$MAP" 2>/dev/null; then
    _n=""
  fi

  rmdir "$LOCK" 2>/dev/null || true
  return 0
}
_resolve_n

# --- 5) Cores ANSI pra faixa do contexto (fail-open: sem % -> sem cor). ---
_C_RESET=$'\033[0m'
_C_YELLOW=$'\033[33m'
_C_RED=$'\033[31m'
_ctx_body="ctx:--%"
if [ -n "$_pct" ]; then
  if   [ "$_pct" -gt 80 ] 2>/dev/null; then _ctx_body="${_C_RED}ctx:${_pct}%${_C_RESET}"
  elif [ "$_pct" -ge 60 ] 2>/dev/null; then _ctx_body="${_C_YELLOW}ctx:${_pct}%${_C_RESET}"
  else                                       _ctx_body="ctx:${_pct}%"        # <60% neutro
  fi
fi

# --- 6) Monta a barra no formato exato: "▲N  ·  ctx:P%  ·  Modelo" ---
#     "▲" colado no N (sem "·"). Separador " · " entre os 3 blocos.
_tri="▲${_n}"    # se _n vazio -> so "▲" (degrade)
printf '%s · %s · %s\n' "$_tri" "$_ctx_body" "$_model"
exit 0
