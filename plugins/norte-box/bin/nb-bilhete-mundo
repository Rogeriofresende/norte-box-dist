#!/usr/bin/env bash
# nb-bilhete-mundo — helper de linha de comando do AVISO DE MUNDO MUDADO (quais arquivos CITADOS no bilhete
# mudaram no git desde o selo) do norte-box (NRT-_990148). Recebe o CAMINHO de um bilhete (handoff) e, se
# algum arquivo que o bilhete cita mudou no git desde o commit-ancora, ecoa UMA linha POR arquivo mudado:
#   ⚠ mudou desde o bilhete: <path> — confira se o recado ainda vale (...)
# Se nenhum citado mudou -> SILENCIO no stdout (so um resumo curto no stderr; nao incomoda). Serve pra
# /norte-retomar mostrar esse aviso FINO logo depois do aviso de idade (nb-bilhete-validade).
#
# USO:
#   nb-bilhete-mundo <arquivo-handoff>   -> ecoa 0+ linhas de aviso no stdout (silencio = nada mudou).
#
# ONDE CONFERE: no CWD (a pasta do projeto do usuario) — le a ancora do cabecalho do bilhete
# (selado-em-commit do /continuar, OU world_anchor:/commit: do session-handoff) e roda `git diff
# --name-only <ancora>..HEAD` no git local. Rode do diretorio do projeto (a /norte-retomar ja roda ali).
#
# SAIDA:
#   stdout -> 0+ linhas de aviso (uma por arquivo citado que mudou). VAZIO = nenhum citado mudou.
#   stderr -> quando nao da pra saber (sem ancora/sem git/commit ausente): 1 linha honesta "nao sei o
#             mundo deste bilhete". Quando 0 mudaram: um resumo curto.
#   exit 0 SEMPRE que conseguiu carregar a peca (fail-open: NUNCA trava a retomada). exit 2 so pra erro de
#   uso (sem argumento). Sem ancora / sem git / commit ausente NAO e erro: cai no fail-open honesto (stderr).
#
# MOLDURA HONESTA (nao overclaim): a peca so cruza "caminho CITADO como texto" x "git diff de NOMES" — NAO
# le o conteudo do arquivo nem entende se a mudanca e RELEVANTE. Um arquivo citado por acaso que mudou
# tambem gera aviso (falso-positivo possivel). E ALERTA pra conferir, NUNCA licenca pra executar. Mudanca
# fora do git (arquivo salvo sem commit) nao conta.
#
# LEIS: LOCAL/zero rede (o bilhete e do proprio projeto e nunca sai da maquina) · fail-open da retomada
# (peca quebrada / sem ancora nao trava a /norte-retomar) · dado e dado (o commit-ancora vira argumento de
# git diff, nunca comando; os caminhos citados so sao comparados como texto). Kill-switch NORTE_MUNDO=0 ->
# inerte (nada no stdout). bash 3.2, set -u.
set -u

_arg="${1:-}"
if [ -z "$_arg" ]; then
  printf '🟡 uso: nb-bilhete-mundo <arquivo-handoff>\n' >&2
  exit 2
fi

# Carrega a lib do mundo (fonte unica). bin/ e hooks/ sao irmaos sob plugins/norte-box/.
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
_lib=""
if [ -n "${_self_dir:-}" ] && [ -f "${_self_dir}/../hooks/_bilhete_mundo.sh" ]; then
  _lib="${_self_dir}/../hooks/_bilhete_mundo.sh"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/hooks/_bilhete_mundo.sh" ]; then
  _lib="${CLAUDE_PLUGIN_ROOT}/hooks/_bilhete_mundo.sh"
fi
if [ -z "$_lib" ]; then
  # fail-open: sem a lib, nao trava a retomada — so avisa no stderr que nao sabe o mundo e segue.
  printf '🟡 nao achei o aviso de mundo mudado nesta instalacao — trate o recado como suposicao.\n' >&2
  exit 0
fi
# shellcheck source=/dev/null
. "$_lib"

command -v _norte_bilhete_mundo >/dev/null 2>&1 || {
  printf '🟡 aviso de mundo mudado incompleto nesta instalacao — trate o recado como suposicao.\n' >&2
  exit 0
}

_norte_bilhete_mundo "$_arg"
exit 0
