#!/usr/bin/env bash
# nb-perguntar — helper de linha de comando do freio "QUANDO TRAVA, PERGUNTA EM VEZ DE CHUTAR" do
# norte-box (NRT-_990484). Quando a IA bate numa parede no MEIO da execucao — falta um DADO que a acao
# ia usar, OU um comando ja falhou 2 vezes seguidas — em vez de CHUTAR, ela chama isto pra PARAR e fazer
# UMA pergunta no formato padrao (1 linha de padaria + 2-3 opcoes + um default seguro que PARA).
#
# USO:
#   nb-perguntar falta-dado <nome-do-dado> [<contexto>]
#       -> ecoa a pergunta padrao pro caso "falta um dado que a acao ia usar".
#   nb-perguntar comando-falhou <comando> <n-falhas> [<ultimo-erro>]
#       -> ecoa a pergunta padrao SE o comando ja falhou 2+ vezes seguidas. Com n<2, ecoa NADA (ainda
#          nao e parede — pode ter sido tropeco). Limiar ajustavel por env NB_PERGUNTA_FALHAS (default 2).
#
# Facil de um hook/skill chamar: passe o sinal + os argumentos e leia o stdout. Se sair vazio, nao havia
# parede a perguntar (ou a peca esta desligada) — o chamador segue como antes.
#
# SAIDA:
#   stdout -> a pergunta padrao (varias linhas) OU vazio (sem parede / peca desligada / abaixo do limiar).
#   exit 0 SEMPRE que conseguiu carregar a peca (fail-open: NUNCA trava a execucao). exit 2 so pra erro
#   de uso (sem sinal). Sinal desconhecido NAO e erro: ecoa vazio e exit 0.
#
# MOLDURA HONESTA (nao overclaim): a peca so DETECTA a parede pelo sinal que voce passa e MONTA a
# pergunta. Ela NAO adivinha o dado, NAO tenta o comando de novo, NAO escolhe o caminho. E um FREIO pra
# PERGUNTAR, nunca uma licenca pra executar sozinho — o default sempre PARA.
#
# LEIS: LOCAL/zero rede (so monta texto, nada sai da maquina) · fail-open (peca quebrada / kill-switch
# nao trava a execucao) · dado e dado (nome do dado, comando e erro entram como TEXTO na pergunta, nunca
# sao executados). Kill-switch NORTE_PERGUNTA=0 -> inerte (nada no stdout). bash 3.2, set -u.
set -u

_sinal="${1:-}"
if [ -z "$_sinal" ]; then
  printf '🟡 uso: nb-perguntar falta-dado <nome-do-dado> [<contexto>]\n' >&2
  printf '       nb-perguntar comando-falhou <comando> <n-falhas> [<ultimo-erro>]\n' >&2
  exit 2
fi

# Carrega a lib da peca (fonte unica). bin/ e hooks/ sao irmaos sob plugins/norte-box/.
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
_lib=""
if [ -n "${_self_dir:-}" ] && [ -f "${_self_dir}/../hooks/_quando_trava.sh" ]; then
  _lib="${_self_dir}/../hooks/_quando_trava.sh"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/hooks/_quando_trava.sh" ]; then
  _lib="${CLAUDE_PLUGIN_ROOT}/hooks/_quando_trava.sh"
fi
if [ -z "$_lib" ]; then
  # fail-open: sem a lib, nao trava a execucao — so segue calado (o chamador nao recebe pergunta).
  exit 0
fi
# shellcheck source=/dev/null
. "$_lib"

command -v _norte_quando_trava >/dev/null 2>&1 || exit 0

_norte_quando_trava "$@"
exit 0
