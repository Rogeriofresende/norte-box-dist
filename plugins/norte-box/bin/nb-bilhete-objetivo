#!/usr/bin/env bash
# nb-bilhete-objetivo <bilhete> — garante a linha "objetivo:" no bilhete (0.3.42).
#
# POR QUE: o /handon da conversa nova lê o "objetivo:" do bilhete pra dizer o PORQUÊ do assunto. O molde do
# bilhete não tinha esse campo, e em 30/09 4 de 5 bilhetes saíram sem ele — mesmo com o objetivo guardado
# na bússola do assunto. Este helper confere cada bilhete na hora de guardar:
#   1. já tem "objetivo:" preenchido            → não mexe
#   2. tem uma seção "## Objetivo" no corpo      → copia a 1ª linha pro topo
#   3. existe uma FONTE de objetivo nesta máquina (NORTE_OBJETIVO_FONTE, ou ~/.claude/scripts/norte-objetivo-do-fio.sh)
#      → pergunta a ela pelo "fio:" do bilhete e copia
#   4. nada disso                                → NÃO inventa: responde "SEM OBJETIVO" pro /continuar avisar a pessoa
#
# Saída (1 linha): "OBJETIVO: <texto>" ou "SEM OBJETIVO". Sempre exit 0 (nunca trava a troca).
# Kill-switch: NORTE_BILHETE_OBJETIVO=0. LOCAL (a fonte opcional é quem decide se usa rede, com prazo de 12s).
set -u
# 0.3.52 (NRT-_995031): o PROGRAMA marca o passo "bilhete_com_objetivo" com a propria saida (nb-passo) —
# fail-open: a saida e o codigo de saida ficam identicos; se a marcacao falhar, nada muda.
# 0.3.53 (NRT-_996798): 2º argumento "obrigado" = quem chamou foi o /obrigado (antes dependia da IA rodar
# "nb-passo --sou obrigado"). E o PROGRAMA confere o ponteiro ULTIMO.md da mesma pasta (antes era uma linha
# solta no SKILL.md que a IA pulava — o passo "ponteiro" nunca chegou em uso real).
if [ -z "${_NB_PASSO_DENTRO:-}" ] && [ "${NORTE_BOX_PASSO:-1}" != "0" ] && [ -f "$(dirname "$0")/nb-passo" ]; then
  _nbp_out="$(_NB_PASSO_DENTRO=1 bash "$0" "$@")"; _nbp_rc=$?
  [ -n "$_nbp_out" ] && printf '%s\n' "$_nbp_out"
  _nbp="$(dirname "$0")/nb-passo"; _nbp_b="${1:-}"; _nbp_hab=bilhete
  [ "${2:-}" = "obrigado" ] && _nbp_hab=obrigado
  ( {
      [ "$_nbp_hab" = "obrigado" ] && bash "$_nbp" --sou obrigado
      bash "$_nbp" "$_nbp_hab" bilhete_com_objetivo --saida "$_nbp_out"
      if [ -n "$_nbp_b" ]; then
        _nbp_d="$(dirname "$_nbp_b")"
        case "$_nbp_d" in
          */norte-out/handoffs) bash "$_nbp" "$_nbp_hab" ponteiro --confere "$_nbp_d/ULTIMO.md" "$_nbp_b" ;;
          *) [ -e "$_nbp_d/ULTIMO.md" ] && bash "$_nbp" "$_nbp_hab" ponteiro --confere "$_nbp_d/ULTIMO.md" "$_nbp_b" ;;
        esac
      fi
    } </dev/null >/dev/null 2>&1 & ) 2>/dev/null || true
  exit $_nbp_rc
fi
B="${1:-}"
[ "${NORTE_BILHETE_OBJETIVO:-1}" = "0" ] && { echo "SEM OBJETIVO (desligado)"; exit 0; }
[ -n "$B" ] && [ -e "$B" ] || { echo "SEM OBJETIVO (bilhete não encontrado)"; exit 0; }
# 0.3.58 (NRT-_998139): quando dá erro, anota o MOTIVO numa lista fechada (sem texto) pro nb-passo juntar ao
# "falhou": sem_python · python_nao_roda · erro_ler · erro_escrever · erro_mostrar · outro. A saída não muda.
# Desligar: NORTE_BILHETE_MOTIVO=0.
_motivo() {
  [ "${NORTE_BILHETE_MOTIVO:-1}" = "0" ] && return 0
  { mkdir -p "$HOME/.norte-box" && printf '%s\tmotivo=%s\n' "$B" "$1" > "$HOME/.norte-box/bilhete-motivo"; } 2>/dev/null || true
}
# 0.3.58 (NRT-_998139): acha um Python 3 que RODE — python3 → python → py -3 (no Windows, o Python do site oficial
# não cria "python3" e o atalho da Microsoft Store toma o lugar). Só aceita quem roda e é versão 3.
# E roda em UTF-8: a tela do Windows é cp1252 e quebrava com emoji/seta no objetivo. Desligar: NORTE_ACHA_PYTHON=0.
# Quem acha é o bin/nb-python (o mesmo de todos os lugares da caixa); sem ele, python3 como antes.
_NBPY="$(dirname "$0")/nb-python"
if [ -f "$_NBPY" ]; then
  bash "$_NBPY" --acha; _rc=$?; _PY=(bash "$_NBPY")
else
  _rc=1; command -v python3 >/dev/null 2>&1 && { _rc=2; python3 -c 'import sys' >/dev/null 2>&1 && _rc=0; }; _PY=(python3)
fi
case "$_rc" in
  0) : ;;
  1) _motivo sem_python; echo "SEM OBJETIVO (sem python3)"; exit 0 ;;
  *) _motivo python_nao_roda; echo "SEM OBJETIVO (erro)"; exit 0 ;;
esac
FONTE="${NORTE_OBJETIVO_FONTE:-$HOME/.claude/scripts/norte-objetivo-do-fio.sh}"
PYTHONUTF8=1 PYTHONIOENCODING=utf-8 "${_PY[@]}" - "$B" "$FONTE" <<'PY' 2>/dev/null
import os, re, subprocess, sys

path, fonte = os.path.realpath(sys.argv[1]), sys.argv[2]
try:
    texto = open(path, encoding="utf-8").read()
except Exception:
    sys.exit(3)  # erro_ler


def diga(s):
    try:
        print(s)
        sys.stdout.flush()
    except Exception:
        sys.exit(5)  # erro_mostrar
m = re.match(r"^---\n(.*?)\n---\n", texto, re.S)
fm = m.group(1) if m else ""


def limpa(s):
    s = " ".join((s or "").split()).strip().strip("\"'").strip()
    s = s.replace(": ", " — ")
    return s.lstrip("-*>#&!|%@`[{ ").strip()[:300]


achado = re.search(r"^objetivo:[ \t]*(.*)$", fm, re.M)
if achado and limpa(achado.group(1)):
    diga("OBJETIVO: " + limpa(achado.group(1)))
    sys.exit(0)

obj, origem = "", ""
# 0.3.55: além de "## Objetivo" + frase na linha de baixo, aceita a frase na MESMA linha do título
# (depois de ":" ou travessão), título em negrito (**Objetivo:** ...) e emoji/símbolo antes da
# palavra (## 🎯 Objetivo). Só olha títulos e linhas em negrito no começo da linha; seção vazia
# continua SEM OBJETIVO (não inventa).
SIMB = r"(?:[^\w\s]+[ \t]*)*"
TITULO = re.compile(r"^#{1,6}[ \t]*" + SIMB + r"objetivos?\b([^\n]*)$", re.I)
NEGRITO = re.compile(r"^[ \t]*(?:[-*][ \t]+)?\*\*[ \t]*" + SIMB + r"objetivos?\b([^*\n]*)\*\*[ \t]*([^\n]*)$", re.I)
NA_LINHA = re.compile(r"^[^:—–\n]{0,40}?(?:[:—–]|[ \t]-[ \t])[ \t]*(\S.*)$")


def na_mesma_linha(resto):
    r = NA_LINHA.match(resto or "")
    return limpa(r.group(1)) if r else ""


ROTULO = re.compile(r"^[ \t]*\*\*[^*\n]+(?::\*\*|\*\*[ \t]*:)")  # **Responsável:** Ana = outro campo


def linha_de_baixo(linhas, i):
    for prox in linhas[i + 1 :]:
        if not prox.strip():
            continue
        if prox.lstrip().startswith(("#", "```")) or ROTULO.match(prox):
            return ""
        return limpa(prox)
    return ""


linhas = texto[m.end() if m else 0 :].split("\n")
em_codigo = False
for i, linha in enumerate(linhas):
    if linha.lstrip().startswith("```"):
        em_codigo = not em_codigo
        continue
    if em_codigo:
        continue
    t, n = TITULO.match(linha), NEGRITO.match(linha)
    if t:
        achou = na_mesma_linha(t.group(1)) or linha_de_baixo(linhas, i)
    elif n:
        achou = limpa(n.group(2)) or na_mesma_linha(n.group(1)) or linha_de_baixo(linhas, i)
    else:
        continue
    if achou:
        obj, origem = achou, "seção Objetivo"
        break

fio = re.search(r"^fio:[ \t]*(NRT-_\d+)", fm, re.M)
if not obj and fio and os.access(fonte, os.X_OK):
    try:
        r = subprocess.run([fonte, fio.group(1)], capture_output=True, text=True, timeout=12)
        linha = (r.stdout or "").strip().splitlines()
        if r.returncode == 0 and linha and limpa(linha[0]):
            obj, origem = limpa(linha[0]), "objetivo guardado do assunto " + fio.group(1)
    except Exception:
        pass

if not obj:
    # 0.3.57 (NRT-_998139): anota SÓ O FORMATO do bilhete (lista fechada, zero texto) pro nb-passo juntar
    # ao "sem_objetivo" — pra saber se o objetivo faltou ou se veio num jeito que o leitor não pega.
    # A saída continua só "SEM OBJETIVO". Desligar: NORTE_BILHETE_FORMA=0. Falha aqui nunca muda nada.
    try:
        if os.environ.get("NORTE_BILHETE_FORMA", "1") != "0":
            corpo = linhas
            tit = [l for l in corpo if re.match(r"^\s*#{1,6}\s", l) or re.match(r"^\s*\*\*", l)]
            if any(TITULO.match(l) or NEGRITO.match(l) for l in corpo):
                secao = "vazia"
            elif any(re.search(r"objetiv", l, re.I) for l in tit):
                secao = "outro_titulo"
            else:
                secao = "ausente"
            obj_topo = "vazia" if re.search(r"^objetivo:", fm, re.M) else "ausente"
            palavra = "sim" if any(re.search(r"objetiv", l, re.I) for l in corpo if l not in tit) else "nao"
            baixo = " ".join(l.lower() for l in tit)
            molde = sum(k in baixo for k in ("onde estamos", "fatos verificados", "proximo passo", "próximo passo", "cuidados"))
            n = len([l for l in corpo if l.strip()])
            forma = "|".join([
                "topo=" + ("sim" if m else "nao"),
                "obj_topo=" + obj_topo,
                "secao=" + secao,
                "palavra=" + palavra,
                "molde=" + ("sim" if molde >= 3 else "parcial" if molde else "nao"),
                "tamanho=" + ("curto" if n < 20 else "medio" if n <= 80 else "longo"),
                "fio=" + ("sim" if fio else "nao"),
                "fonte=" + ("sim" if os.access(fonte, os.X_OK) else "ilegivel" if os.path.exists(fonte) else "nao"),
            ])
            d = os.path.join(os.path.expanduser("~"), ".norte-box")
            os.makedirs(d, exist_ok=True)
            with open(os.path.join(d, "bilhete-forma"), "w", encoding="utf-8") as f:
                f.write(path + "\t" + forma + "\n")
    except Exception:
        pass
    diga("SEM OBJETIVO")
    sys.exit(0)

if m:
    corpo_fm = re.sub(r"^objetivo:[ \t]*$\n?", "", fm, flags=re.M).rstrip("\n")
    novo = "---\n" + corpo_fm + "\nobjetivo: " + obj + "\n---\n" + texto[m.end():]
else:
    novo = "---\nobjetivo: " + obj + "\n---\n" + texto
tmp = path + ".obj.tmp"
try:
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(novo)
    os.replace(tmp, path)
except Exception:
    sys.exit(4)  # erro_escrever
diga("OBJETIVO: " + obj + " (copiado de: " + origem + ")")
PY
_rc=$?
if [ "$_rc" != 0 ]; then
  case "$_rc" in 3) _motivo erro_ler ;; 4) _motivo erro_escrever ;; 5) _motivo erro_mostrar ;; *) _motivo outro ;; esac
  echo "SEM OBJETIVO (erro)"
fi
# 0.3.56 (NRT-_997988): o ponteiro ULTIMO.md da mesma pasta passa a seguir o bilhete conferido (caso Ygor
# 21/10: a IA corrigiu o objetivo e nao refez o ponteiro). So mexe se o bilhete for o mais novo; calado.
[ -f "$(dirname "$0")/nb-ponteiro-reaponta" ] && bash "$(dirname "$0")/nb-ponteiro-reaponta" "$B" </dev/null >/dev/null 2>&1
exit 0
