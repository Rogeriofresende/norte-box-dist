#!/usr/bin/env bash
# nb-estreia — a ESTREIA COM ENTREGA PROVADA do norte-box (NRT-_990341, passo 10 do plano).
# Roda UMA tarefa REAL do tipo documento→checklist PONTA A PONTA e termina com um REGISTRO DE ENTREGA
# que so recebe o carimbo "🟢 ENTREGA PROVADA" quando a conferencia deu PROVADO (cobertura completa, zero
# orfao, zero suspeita, zero contradicao). Se faltou item -> "🟡 ENTREGA NAO-PROVADA" + o que faltou, e
# NAO sela.
#
# NAO reconstroi a conferencia: REUSA o motor contrato-doc (nb-contrato-doc / _norte_contrato_doc_provar).
# O carimbo le o EXIT REAL do motor + a prova gravada, NUNCA a presenca de arquivo.
#
# USO:  nb-estreia <documento> <checklist> [rotulo]
#   <documento> = o texto a conferir (qualquer arquivo de texto).
#   <checklist> = a lista de exigencias (uma por linha; "descricao :: ancora"; "NAO: ..." afirma ausencia).
#   [rotulo]    = rotulo curto (opcional; default "estreia").
#
# SAIDA (stdout, humano de padaria):
#   🟢 ENTREGA PROVADA — ... a conferencia fechou       -> exit 0  (SELOU; fichinha virou verde)
#   🟡 ENTREGA NAO-PROVADA — ... o que faltou            -> exit 1  (algum item orfao / contradicao)
#   🟡 nao consegui estrear / estreia desligada          -> exit 2  (pre-condicao / kill-switch)
#
# KILL-SWITCH: NORTE_ESTREIA=0 desliga a estreia (volta ao comportamento de hoje). O registro NUNCA sai da
# maquina (privado por padrao). LEIS: fail-honest, set -u, nao usa dado como comando.
set -u

_doc="${1:-}"
_chk="${2:-}"
_rot="${3:-estreia}"

if [ -z "$_doc" ] || [ -z "$_chk" ]; then
  echo "🟡 nao consegui estrear: diga qual documento e qual checklist (uso: nb-estreia <documento> <checklist> [rotulo])."
  exit 2
fi

# Carrega as libs (fonte unica). bin/ e hooks/ sao irmaos sob plugins/norte-box/.
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
_hooks=""
if [ -n "${_self_dir:-}" ] && [ -d "${_self_dir}/../hooks" ]; then
  _hooks="${_self_dir}/../hooks"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -d "${CLAUDE_PLUGIN_ROOT}/hooks" ]; then
  _hooks="${CLAUDE_PLUGIN_ROOT}/hooks"
fi
if [ -z "$_hooks" ] || [ ! -f "${_hooks}/_estreia.sh" ]; then
  echo "🟡 nao consegui estrear: nao achei a estreia nesta instalacao."
  exit 2
fi
# a base reusada: _situacao.sh (hash A3 + fichinha), _provar.sh (raiz das provas + marcador do selo),
# _contrato_doc.sh (o motor documento->checklist que a estreia orquestra).
[ -f "${_hooks}/_situacao.sh" ]    && { . "${_hooks}/_situacao.sh"    2>/dev/null || true; }
[ -f "${_hooks}/_provar.sh" ]      && { . "${_hooks}/_provar.sh"      2>/dev/null || true; }
[ -f "${_hooks}/_contrato_doc.sh" ] && { . "${_hooks}/_contrato_doc.sh" 2>/dev/null || true; }
# shellcheck source=/dev/null
. "${_hooks}/_estreia.sh"

command -v _norte_estreia_selar >/dev/null 2>&1 || { echo "🟡 nao consegui estrear: motor incompleto (estreia ausente)."; exit 2; }

_norte_estreia_selar "$_doc" "$_chk" "$_rot"
exit $?
