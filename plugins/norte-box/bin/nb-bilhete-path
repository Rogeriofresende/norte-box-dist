#!/usr/bin/env bash
# nb-bilhete-path <dir-base> <slug> — devolve um caminho de bilhete GARANTIDAMENTE novo.
#
# Fecha o furo de PERDA de trabalho (NRT-_991398, teste 16/09): o nome com precisão de MINUTO
# (slug-AAAAMMDD-HHMM.md) COLIDE se dois salvamentos caem no mesmo minuto com o mesmo assunto —
# o segundo sobrescreve o primeiro e um bilhete SOME. Aqui: precisão de SEGUNDO + nunca sobrescreve
# (se ainda colidir no mesmo segundo, cria -2, -3, …). Provado: 3 salvamentos no mesmo segundo -> 3 arquivos.
#
# Uso:   NOVO="$(nb-bilhete-path "$DIR" "$slug")"   # $DIR = saída do nb-resolve-outdir
# Imprime o caminho .md pronto pra gravar. Cria a pasta handoffs/ antes (fecha o "1º uso pode falhar").
# LOCAL, sem rede. Fail-open: em erro, ainda tenta imprimir um caminho utilizável.
set -u
DIR="${1:?uso: nb-bilhete-path <dir-base> <slug>}"
SLUG_RAW="${2:?uso: nb-bilhete-path <dir-base> <slug>}"

# sanitize leve: só [a-zA-Z0-9._-] (acento/espaço/barra no nome quebram a leitura depois)
SLUG="$(printf '%s' "$SLUG_RAW" | tr -c 'a-zA-Z0-9._-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')"
[ -z "$SLUG" ] && SLUG="bilhete"

HDIR="$DIR/handoffs"
mkdir -p "$HDIR" 2>/dev/null || true

base="$HDIR/${SLUG}-$(date +%Y%m%d-%H%M%S)"
cand="${base}.md"
n=2
while [ -e "$cand" ]; do
  cand="${base}-${n}.md"
  n=$((n + 1))
done
printf '%s\n' "$cand"
