#!/usr/bin/env bash
# nb-vale-manter — helper de linha de comando do "VALE MANTER?" (killing-review em SOMBRA) do
#   norte-box (GAP 4 fatia 1, NRT-_990148). Cruza os KITS que voce criou × a ultima vez que cada um
#   rodou (pelos registros de entrega locais) e SUGERE quais parecem sem retorno espontaneo — pra voce
#   decidir NA MAO se aposenta. EM SOMBRA: so LE e IMPRIME; NUNCA apaga, edita ou desativa nada.
#
#   ▲ vale-manter — revisao em SOMBRA (so relatorio; NADA sera removido, editado ou desativado). ...
#   CANDIDATOS A CONFERIR (>= N dias de vida, sem rodar nos ultimos N dias):
#     • <kit> — criado ha Xd, rodou Nx (...) — usou e dormiu
#   MUITO NOVOS PRA JULGAR (< N dias de vida — nunca sao candidatos):
#     • <kit> (criado ha Xd · ...)
#   NAO SINALIZADOS (uso recente, nos ultimos N dias) — N:
#     • <kit> (rodou Nx · ultimo uso <data>)
#
# USO:
#   nb-vale-manter                 -> revisa com o limiar padrao (30 dias).
#   nb-vale-manter --dias N        -> revisa com o limiar de N dias (a flag vence o env).
#
# ONDE OLHA: nos kits em $HOME/.norte-box/kits/ e nos registros de entrega em $HOME/.norte-box/entregas/
#   (ou NB_VALE_MANTER_KITS_DIR / NB_VALE_MANTER_ENTREGAS_DIR, pro teste apontar pra fixtures). So LE
#   arquivos locais do proprio usuario — nunca sai da maquina.
#
# SAIDA:
#   stdout -> o relatorio (cabecalho de sombra + 3 baldes) ou "0 kits, nada a revisar".
#   exit 0 SEMPRE que conseguiu carregar a peca (fail-open: NUNCA trava). Dir ausente / sem historico
#   NAO e erro: e mensagem honesta no stdout com exit 0.
#
# MOLDURA HONESTA (nao overclaim): a peca mede SO QUANDO o kit rodou (pelos registros locais) — NAO
#   julga a qualidade nem o conteudo do kit. Um kit usado por fora da esteira apareceria como "sem
#   historico" (falso-positivo possivel). E SUGESTAO pra CONFERIR, NUNCA licenca pra apagar. Kit novo
#   demais nunca e candidato.
#
# LEIS: LOCAL/zero rede (le so os kits e entregas locais, nunca sai da maquina) · SOMBRA/report-only
#   (so LE e IMPRIME, nunca escreve/apaga/edita) · fail-open (peca quebrada / dir ausente nao trava) ·
#   dado e dado (o nome do kit so vira argumento de grep -F, nunca comando). Kill-switch
#   NORTE_BOX_VALE_MANTER_OFF=1 -> inerte (nada no stdout). bash 3.2, set -u.

set -u

# Carrega a lib (fonte unica). bin/ e hooks/ sao irmaos sob plugins/norte-box/.
# shellcheck source=/dev/null
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
_lib=""
if [ -n "${_self_dir:-}" ] && [ -f "${_self_dir}/../hooks/_vale_manter.sh" ]; then
  _lib="${_self_dir}/../hooks/_vale_manter.sh"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/hooks/_vale_manter.sh" ]; then
  _lib="${CLAUDE_PLUGIN_ROOT}/hooks/_vale_manter.sh"
fi
if [ -z "$_lib" ]; then
  # fail-open: sem a lib, nao trava — so avisa no stderr e segue.
  printf '▲ nao achei o "vale manter?" nesta instalacao — siga sem a revisao (nao trava nada).\n' >&2
  exit 0
fi

# shellcheck source=/dev/null
. "$_lib"

_norte_vale_manter "$@"
exit 0
