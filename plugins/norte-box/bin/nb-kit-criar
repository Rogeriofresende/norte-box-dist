#!/usr/bin/env bash
# nb-kit-criar — GUARDA uma tarefa provada como KIT reusavel (NRT-_990380, passo 11 do plano).
#
# Copia um CHECKLIST pra um kit privado ($HOME/.norte-box/kits/<nome>/) e grava o cartao do kit. Depois,
# nb-kit-rodar roda a MESMA conferencia em documentos novos pela esteira real. O kit e IMUTAVEL: criar com
# nome que ja existe RECUSA (use outro nome pra uma versao nova). ORIGEM 🟢 so com prova real (3 gates:
# checklist_hash bate + registro 🟢 + assinatura confere); senao 🟡 honesto.
#
# USO:  nb-kit-criar <nome> <checklist> [registro]
#   <nome>      = nome curto do kit (slug: letras/numeros/./-/_ ; sem barra, espaco, ".." — vira uma pasta).
#   <checklist> = o arquivo do checklist (uma exigencia por linha; "descricao :: ancora").
#   [registro]  = (opcional) o registro de entrega de um run VERDE, pra carimbar a origem 🟢 se conferir.
#
# KILL-SWITCH: NORTE_KITS=0 desliga (recusa, exit 2). O kit NUNCA sai da maquina (privado por padrao).
# LEIS: fail-honest, set -u, nao usa dado como comando (o <nome> e validado como slug antes de virar caminho).
set -u

_nome="${1:-}"
_chk="${2:-}"
_reg="${3:-}"

# Carrega as libs (fonte unica). bin/ e hooks/ sao irmaos sob plugins/norte-box/.
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
_hooks=""
if [ -n "${_self_dir:-}" ] && [ -d "${_self_dir}/../hooks" ]; then
  _hooks="${_self_dir}/../hooks"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -d "${CLAUDE_PLUGIN_ROOT}/hooks" ]; then
  _hooks="${CLAUDE_PLUGIN_ROOT}/hooks"
fi
if [ -z "$_hooks" ] || [ ! -f "${_hooks}/_kits.sh" ]; then
  echo "🟡 nao consegui criar o kit: nao achei os kits nesta instalacao."
  exit 2
fi

# a base reusada: _situacao.sh (hash A3), _provar.sh, _estreia.sh (selar/verificar). Carrega por seguranca.
# shellcheck source=/dev/null
. "${_hooks}/_situacao.sh"     2>/dev/null || true
# shellcheck source=/dev/null
. "${_hooks}/_provar.sh"       2>/dev/null || true
# shellcheck source=/dev/null
. "${_hooks}/_contrato_doc.sh" 2>/dev/null || true
# shellcheck source=/dev/null
. "${_hooks}/_estreia.sh"      2>/dev/null || true
# shellcheck source=/dev/null
. "${_hooks}/_kits.sh"

command -v _norte_kit_criar >/dev/null 2>&1 || { echo "🟡 nao consegui criar o kit: motor incompleto."; exit 2; }

_norte_kit_criar "$_nome" "$_chk" "$_reg"
exit $?
