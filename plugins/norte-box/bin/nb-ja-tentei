#!/usr/bin/env bash
# nb-ja-tentei — helper de linha de comando do "JA TENTEI ISSO?" (busca nos bilhetes ANTIGOS do proprio
# usuario por termos) do norte-box (GAP 5 fatia 1, NRT-_990148). Recebe as PALAVRAS do trabalho que voce
# vai comecar e, se algum bilhete de handoff antigo casa com essas palavras, ecoa os 5 mais RECENTES:
#   ▲ ja tentei? — pista textual, nao veredito (confira o bilhete antes de decidir)
#   1. [data] <arquivo>
#      <linha de amostra>
#   ...
#   (N de M casaram · busca: "<termos>" · so casamento de palavras nos SEUS bilhetes locais)
# Se nada casa -> uma linha honesta ("nenhum bilhete casou ... pode ser novo mesmo"). Serve pra rodar ANTES
# de atacar um problema, pra nao re-resolver algo que voce ja tentou.
#
# USO:
#   nb-ja-tentei <termo> [<termo> ...]   -> ecoa a moldura + itens, ou uma linha honesta.
#
# ONDE PROCURA: nos *.md de ~/.claude/handoffs (ou NB_JA_TENTEI_DIR, pro teste apontar pra uma fixture).
# So LE arquivos locais do proprio usuario — nunca sai da maquina.
#
# SAIDA:
#   stdout -> a moldura + itens quando casa; senao uma linha honesta (dir vazio / termo curto / sem match).
#   exit 0 SEMPRE que conseguiu carregar a peca (fail-open: NUNCA trava o trabalho). exit 2 so pra erro de
#   uso (sem argumento). Dir vazio / sem match NAO e erro: e mensagem honesta no stdout com exit 0.
#
# MOLDURA HONESTA (nao overclaim): a peca so CASA PALAVRA (string fixa) — NAO le/entende o conteudo do
# bilhete nem julga se e o mesmo problema. Casamento por acaso e possivel. E PISTA pra conferir o bilhete,
# NUNCA a conclusao de que "ja resolvi, pode pular". So olha os bilhetes locais; ausencia de match nao prova
# que e novo.
#
# LEIS: LOCAL/zero rede (le so *.md locais do proprio usuario, nunca sai da maquina) · fail-open (peca
# quebrada / dir vazio nao trava o trabalho) · dado e dado (os termos so viram argumento de grep -F, nunca
# comando). Kill-switch NORTE_JA_TENTEI=0 -> inerte (nada no stdout). bash 3.2, set -u.
set -u

if [ "$#" -eq 0 ]; then
  printf '▲ uso: nb-ja-tentei <termo> [<termo> ...]\n' >&2
  exit 2
fi

# Carrega a lib (fonte unica). bin/ e hooks/ sao irmaos sob plugins/norte-box/.
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
_lib=""
if [ -n "${_self_dir:-}" ] && [ -f "${_self_dir}/../hooks/_ja_tentei.sh" ]; then
  _lib="${_self_dir}/../hooks/_ja_tentei.sh"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/hooks/_ja_tentei.sh" ]; then
  _lib="${CLAUDE_PLUGIN_ROOT}/hooks/_ja_tentei.sh"
fi
if [ -z "$_lib" ]; then
  # fail-open: sem a lib, nao trava o trabalho — so avisa no stderr e segue.
  printf '▲ nao achei o "ja tentei?" nesta instalacao — siga sem a pista (nao trava o trabalho).\n' >&2
  exit 0
fi
# shellcheck source=/dev/null
. "$_lib"

command -v _norte_ja_tentei >/dev/null 2>&1 || {
  printf '▲ "ja tentei?" incompleto nesta instalacao — siga sem a pista (nao trava o trabalho).\n' >&2
  exit 0
}

_norte_ja_tentei "$@"
exit 0
