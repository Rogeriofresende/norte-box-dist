#!/usr/bin/env bash
# nb-ponteiro-reaponta <bilhete> — depois do conferente do objetivo, deixa o ULTIMO.md da mesma pasta
# apontando pro bilhete conferido, SEM atropelar outra janela (0.3.56 · NRT-_997988 · conselho ponteiroygor).
#
# POR QUE: caso Ygor 21/10 — o conferente disse "SEM OBJETIVO", a IA corrigiu o bilhete e rodou o conferente
# de novo, mas NAO refez o Passo 3 (ULTIMO.md). Na maquina dele o ULTIMO.md e COPIA: ficou a versao sem
# objetivo, e quem retomar pelo ULTIMO pega o bilhete errado. Isto passa a ser feito pelo PROGRAMA.
#
# REGRA: o ULTIMO.md so passa a mostrar o bilhete conferido se ele for o MAIS NOVO da pasta ("mais novo" = data
#   e hora NO NOME, que nasce na criacao; editar nao muda). Existe outro com data igual ou maior (outra janela
#   salvou depois, ou empate) -> NAO mexe. Nome sem data reconhecivel -> NAO mexe. Atalho continua atalho,
#   copia continua copia. A conferencia e feita 2x: antes e no ULTIMO instante antes da troca (2 janelas ao
#   mesmo tempo). Quando troca, deixa a marca ~/.norte-box/ponteiro-reapontou: o passo "ponteiro" vira
#   "reapontou" (conta a parte), nao "ok" calado.
# Troca atomica (arquivo temporario + rename) dentro de uma trava curta (pasta .ULTIMO.lock).
# LEIS: exit 0 SEMPRE, nunca imprime nada, sem rede. Desligar: NORTE_PONTEIRO_REAPONTA=0.
set -u
[ "${NORTE_PONTEIRO_REAPONTA:-1}" = "0" ] && exit 0
[ -n "${1:-}" ] && [ -e "$1" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
python3 - "$1" <<'PY' >/dev/null 2>&1 || true
import os, re, shutil, sys, time

b = os.path.realpath(sys.argv[1])
d = os.path.dirname(b)
u = os.path.join(d, "ULTIMO.md")
if os.path.basename(b) == "ULTIMO.md" or not os.path.lexists(u):
    sys.exit(0)

PADROES = (
    re.compile(r"(\d{4})(\d{2})(\d{2})-(\d{2})(\d{2})(\d{2})(?:-(\d+))?\.md$"),          # slug-AAAAMMDD-HHMMSS[-N].md
    re.compile(r"(\d{4})-(\d{2})-(\d{2})-(\d{2})(\d{2})(\d{2})(?:-[^/]*)?\.md$"),          # AAAA-MM-DD-HHMMSS-slug.md
    re.compile(r"(\d{4})(\d{2})(\d{2})-(\d{2})(\d{2})()(?:-(\d+))?\.md$"),                 # slug-AAAAMMDD-HHMM[-N].md (antigo)
)


def chave(p):
    nome = os.path.basename(p)
    for rx in PADROES:
        m = rx.search(nome)
        if m:
            g = m.groups()
            seg = int(g[5] or 0)
            extra = int(g[6]) if len(g) > 6 and g[6] else 1
            try:
                t = time.mktime((int(g[0]), int(g[1]), int(g[2]), int(g[3]), int(g[4]), seg, 0, 0, -1))
            except Exception:
                return None
            return (t, extra)
    return None


def sem_objetivo(p):
    try:
        t = open(p, encoding="utf-8").read()
    except Exception:
        return None
    m = re.match(r"---\n(.*?)\n---\n", t, re.S)
    if not m:
        return t
    fm = re.sub(r"^objetivo:[^\n]*(\n|\Z)", "", m.group(1), flags=re.M).strip("\n")
    return ("---\n" + fm + "\n---\n" if fm else "") + t[m.end():]


kb = chave(b)
if kb is None:
    sys.exit(0)


def irmaos():
    try:
        nomes = os.listdir(d)
    except Exception:
        return None
    return [os.path.join(d, n) for n in nomes
            if n.endswith(".md") and n != "ULTIMO.md" and not os.path.islink(os.path.join(d, n))]


def e_o_mais_novo():
    # So o bilhete MAIS NOVO da pasta pode ser o ULTIMO. Outro com data igual ou maior = na duvida, nao mexe.
    ps = irmaos()
    if ps is None:
        return False
    for p in ps:
        if os.path.samefile(p, b):
            continue
        k = chave(p)
        if k is not None and k >= kb:
            return False
    return True


def ja_certo():
    if os.path.islink(u):
        alvo = os.path.join(d, os.readlink(u))
        return os.path.exists(alvo) and os.path.samefile(alvo, b)
    try:
        return open(u, "rb").read() == open(b, "rb").read()
    except Exception:
        return False


if ja_certo() or not e_o_mais_novo():
    sys.exit(0)

trava = os.path.join(d, ".ULTIMO.lock")
for _ in range(40):
    try:
        os.mkdir(trava)
        break
    except FileExistsError:
        try:
            if time.time() - os.stat(trava).st_mtime > 10:
                os.rmdir(trava)
                continue
        except Exception:
            pass
        time.sleep(0.05)
    except Exception:
        sys.exit(0)
else:
    sys.exit(0)

try:
    atalho = os.path.islink(u)
    tmp = u + ".reaponta.tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    if atalho:
        os.symlink(os.path.basename(b), tmp)
    else:
        shutil.copyfile(b, tmp)
    pausa = os.environ.get("NORTE_PONTEIRO_TESTE_PAUSA_S")  # so pro teste da corrida (2 janelas ao mesmo tempo)
    if pausa:
        time.sleep(float(pausa))
    # Confere DE NOVO no ultimo instante: se outra janela criou um bilhete mais novo enquanto isso, desiste.
    if ja_certo() or not e_o_mais_novo():
        os.remove(tmp)
        sys.exit(0)
    # Copia que so difere pela linha "objetivo:" = o proprio conferente escreveu o objetivo DEPOIS do Passo 3:
    # o ponteiro ja era deste bilhete -> so atualiza, sem marcar "reapontou" (a IA nao esqueceu nada).
    so_objetivo = (not atalho) and sem_objetivo(u) is not None and sem_objetivo(u) == sem_objetivo(b)
    os.replace(tmp, u)
    if so_objetivo:
        sys.exit(0)
    # Conta a parte (o nb-passo le e marca "reapontou" em vez de "ok") — o painel continua vendo o esquecimento.
    try:
        sd = os.path.join(os.path.expanduser("~"), ".norte-box")
        os.makedirs(sd, exist_ok=True)
        with open(os.path.join(sd, "ponteiro-reapontou"), "w", encoding="utf-8") as f:
            f.write(b)
    except Exception:
        pass
finally:
    try:
        if os.path.lexists(u + ".reaponta.tmp"):
            os.remove(u + ".reaponta.tmp")
    except Exception:
        pass
    try:
        os.rmdir(trava)
    except Exception:
        pass
PY
exit 0
