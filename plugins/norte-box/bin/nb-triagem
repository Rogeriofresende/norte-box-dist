#!/usr/bin/env bash
# nb-triagem — helper de linha de comando da "TRIAGEM DO PEDIDO" do norte-box refeita pra NUNCA CRAVAR
# (NRT-_990484, conversa 746 passo 3). Antes de agir sobre um pedido do CEO, um hook/skill chama isto
# pra dar UMA sugestao-a-confirmar do que o pedido PARECE ser — sempre como PALPITE, nunca como certeza.
#
# USO:
#   nb-triagem <pedido>
#       -> ecoa a sugestao padrao: "isso me parece <tipo> — confirma?" + 2-3 opcoes + default que PARA.
#
# POR QUE "NUNCA CRAVAR": a versao velha NOMEAVA o tipo por lista de palavras e AFIRMAVA com certeza
# ("Entendi como: publicar"). Ela errava a NEGACAO ("nao publica" -> "publicar") e invertia a intencao
# calada. Aqui o tipo detectado e so um CHUTE a confirmar — errar e ok, cravar nao. A ultima palavra e
# sempre do CEO (as opcoes + o default garantem).
#
# SAIDA:
#   stdout -> a sugestao-a-confirmar (varias linhas) OU vazio (peca desligada por kill-switch).
#   exit 0 SEMPRE que conseguiu carregar a peca (fail-open: NUNCA trava a execucao). exit 2 so pra erro
#   de uso (sem pedido).
#
# MOLDURA HONESTA (nao overclaim): a peca so PALPITA o tipo por pistas de texto e MONTA a sugestao. Ela
# NAO decide, NAO age, NAO classifica com certeza. E uma SUGESTAO a confirmar, nunca uma afirmacao.
#
# LEIS: LOCAL/zero rede (so monta texto, nada sai da maquina) · fail-open (peca quebrada / kill-switch
# nao trava a execucao) · dado e dado (o pedido entra como TEXTO na sugestao, nunca e executado).
# Kill-switch NORTE_TRIAGEM=0 -> inerte (nada no stdout). bash 3.2, set -u.
set -u

_pedido="${1:-}"
if [ -z "$_pedido" ]; then
  printf '🟡 uso: nb-triagem "<o pedido do CEO em texto>"\n' >&2
  exit 2
fi

# Carrega a lib da peca (fonte unica). bin/ e hooks/ sao irmaos sob plugins/norte-box/.
_self_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
_lib=""
if [ -n "${_self_dir:-}" ] && [ -f "${_self_dir}/../hooks/_triagem.sh" ]; then
  _lib="${_self_dir}/../hooks/_triagem.sh"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/hooks/_triagem.sh" ]; then
  _lib="${CLAUDE_PLUGIN_ROOT}/hooks/_triagem.sh"
fi
if [ -z "$_lib" ]; then
  # fail-open: sem a lib, nao trava a execucao — so segue calado (o chamador nao recebe sugestao).
  exit 0
fi
# shellcheck source=/dev/null
. "$_lib"

command -v _norte_triar >/dev/null 2>&1 || exit 0

_norte_triar "$_pedido"
exit 0
