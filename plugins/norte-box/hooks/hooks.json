{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/secret-guard.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/confirmar-antes.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/consent-gate.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/deriva-perguntar.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/triagem-emit.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-emit.sh\"",
            "async": true,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/atrito-emit.sh\"",
            "async": true,
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-emit.sh\"",
            "async": true,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/atrito-emit.sh\"",
            "async": true,
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/situacao-abrir.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/modo-selo.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/time-apresentar.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/voz-norte-regra.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/vigia-doctor.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-drain.sh\"",
            "async": true,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/atrito-drain.sh\"",
            "async": true,
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/situacao-gravar.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/diario-gravar.sh\"",
            "async": false,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-stop.sh\"",
            "async": true,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/telemetry-drain.sh\"",
            "async": true,
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/atrito-drain.sh\"",
            "async": true,
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
